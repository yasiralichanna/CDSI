# CDSI Environment Configuration
# Copy this file to .env and fill in your values

# ─── API Keys ───
PHISHTANK_API_KEY=your_phishtank_api_key
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ─── Server ───
API_HOST=0.0.0.0
API_PORT=8000
USE_SIMULATION=false
DEBUG=false
LOG_LEVEL=info

# ─── Kafka ───
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_THREATS=cdsi.threats
KAFKA_TOPIC_CONSENSUS=cdsi.consensus
KAFKA_TOPIC_TELEMETRY=cdsi.telemetry

# ─── ZeroMQ ───
ZMQ_HOST=127.0.0.1
ZMQ_PORT=5555
ZMQ_PUB_ADDRESS=tcp://127.0.0.1:5555
ZMQ_SUB_ADDRESS=tcp://127.0.0.1:5555

# ─── gRPC ───
GRPC_SERVER_ADDRESS=0.0.0.0:50051
GRPC_USE_TLS=false
GRPC_CERT_PATH=certs/server.crt
GRPC_KEY_PATH=certs/server.key

# ─── Wazuh ───
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# ─── Database ───
DATABASE_URL=sqlite:///./cdsi.db

# ─── Security ───
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ─── Models ───
MODEL_STORAGE_PATH=./models
DATASET_STORAGE_PATH=./datasets

# ─── Consensus ───
CONSENSUS_THRESHOLD=0.66
CONSENSUS_TIMEOUT_MS=5000
